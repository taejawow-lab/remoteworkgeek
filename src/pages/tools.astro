---
import BaseLayout from '../layouts/BaseLayout.astro';
import RemoteMark from '../components/RemoteMark.astro';
const items=['Chair adjusted','Monitor at eye line','Keyboard neutral','Backup internet','Password manager','VPN rule','Async status doc','Meeting fallback'];
---
<BaseLayout title="Remote Work Tools" description="Interactive remote-work setup checklist and gear comparison for RemoteWorkGeek readers."><section class="wrap py-16 md:py-24"><p class="eyebrow"><span class="dot"></span>Setup tools</p><h1 class="mt-5 max-w-3xl text-5xl md:text-7xl">Measure your remote-work setup before buying more gear.</h1><p class="mt-6 max-w-2xl text-xl text-[var(--ink-soft)]">Use this quick checklist to audit ergonomics, backup connectivity, and security basics. Your progress stays in this browser only.</p><div class="mt-10 grid gap-8 lg:grid-cols-[220px_1fr]"><aside class="rwg-card p-6"><div class="score-ring" id="score-ring" style="--score:0%"><span id="score-label">0%</span></div><p class="mt-5 text-sm text-[var(--muted)]">Saved locally as <code>rwg-checklist</code>.</p></aside><div class="tools-grid">{items.map((item,i)=><label class="tool-card rwg-card flex items-center gap-4"><input type="checkbox" data-check={i} class="h-5 w-5 accent-[var(--accent)]"/><span>{item}</span></label>)}</div></div></section><script is:inline>(()=>{const key='rwg-checklist';const boxes=[...document.querySelectorAll('[data-check]')];const saved=JSON.parse(localStorage.getItem(key)||'[]');boxes.forEach((b,i)=>b.checked=!!saved[i]);function upd(){const vals=boxes.map(b=>b.checked);localStorage.setItem(key,JSON.stringify(vals));const pct=Math.round(vals.filter(Boolean).length/boxes.length*100);document.getElementById('score-label').textContent=pct+'%';document.getElementById('score-ring').style.setProperty('--score',pct+'%');}boxes.forEach(b=>b.addEventListener('change',upd));upd();})();</script></BaseLayout>
