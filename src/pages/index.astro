---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ArticleCard from '../components/ArticleCard.astro';
import RemoteMark from '../components/RemoteMark.astro';
const posts=(await getCollection('posts')).filter((p)=>!p.data.draft).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const featured=posts.slice(0,4); const recent=posts.slice(4,14);
const siteDescription=import.meta.env.PUBLIC_SITE_DESCRIPTION||'';
const cats=[['Home Office','home-office','Ergonomics, lighting, acoustics, and the physical desk.'],['Remote Work Setup','remote-work-setup','Gear, power, displays, and travel-ready kits.'],['Remote Work Operations','remote-work-operations','Async handoffs, meetings, and distributed collaboration.'],['Remote Work Security','remote-work-security','Passkeys, VPN rules, privacy, and device-loss drills.']];
---
<BaseLayout title="Remote Work Setup and Productivity Guides" description={siteDescription}>
  <Hero featured={posts[0]} postCount={posts.length} ctaHref={`/posts/${posts[0]?.slug}/`} />
  <section class="section"><div class="wrap"><div class="row-between section-head"><div><p class="eyebrow"><span class="dot"></span>Work categories</p><h2 class="section-title">Measure the whole remote-work stack.</h2></div><a href="/categories/" class="btn btn-ghost">All categories →</a></div><div class="cat-grid">{cats.map(([label,slug,blurb])=><a href={`/category/${slug}/`} class="cat-card rwg-card" data-cat={slug}><span class="cat-card-icon"><RemoteMark class="h-8 w-8" /></span><span class="cat-card-body"><span class="cat-card-head"><span class="cat-card-title">{label}</span><span>→</span></span><span class="cat-card-blurb">{blurb}</span></span></a>)}</div></div></section>
  {featured.length>0 && <section id="latest" class="section"><div class="wrap"><div class="row-between section-head"><div><p class="eyebrow"><span class="dot"></span>Editor’s picks</p><h2 class="section-title">Recent, cited, practical.</h2></div><a class="btn btn-ghost" href="/posts/">View archive →</a></div><div class="feature-grid">{featured.slice(0,3).map((post,i)=><ArticleCard title={post.data.title} description={post.data.description} href={`/posts/${post.slug}/`} image={post.data.heroImage} category={post.data.category} pubDate={post.data.pubDate} readingTime={post.data.readingTime} index={i} />)}</div></div></section>}
  <section class="section pb-24"><div class="wrap"><div class="row-between section-head"><div><p class="eyebrow"><span class="dot"></span>Latest briefings</p><h2 class="section-title">What changed at the desk.</h2></div><p class="num">{recent.length} stories · sorted by date</p></div><div class="row-list">{recent.map((post,i)=><ArticleCard variant="row" title={post.data.title} description={post.data.description} href={`/posts/${post.slug}/`} category={post.data.category} pubDate={post.data.pubDate} readingTime={post.data.readingTime} index={i+4} />)}</div></div></section>
</BaseLayout>
