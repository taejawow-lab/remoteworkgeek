---
import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import References from '../components/References.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
  category?: string;
  sources?: Array<{ title: string; url: string; author?: string; year?: string }>;
  affiliate?: boolean;
  visualsCount?: number;
  hasVideo?: boolean;
  headings?: Array<{ depth: number; slug: string; text: string }>;
  faq?: Array<{ question: string; answer: string }>;
  internalLinks?: string[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  category,
  sources = [],
  affiliate = false,
  visualsCount = 0,
  hasVideo = false,
  headings = [],
  faq = [],
  internalLinks = [],
} = Astro.props;

const articleSchema = {
  '@type': 'Article',
  headline: title,
  description,
  image: heroImage,
  datePublished: pubDate?.toISOString(),
  dateModified: (updatedDate || pubDate)?.toISOString(),
  author: {
    '@type': 'Organization',
    name: import.meta.env.PUBLIC_SITE_NAME + ' Editorial Team',
    url: import.meta.env.PUBLIC_SITE_URL,
  },
  publisher: {
    '@type': 'NewsMediaOrganization',
    name: import.meta.env.PUBLIC_SITE_NAME,
    url: import.meta.env.PUBLIC_SITE_URL,
  },
};

const faqSchema = faq.length > 0 ? {
  '@type': 'FAQPage',
  mainEntity: faq.map((q) => ({
    '@type': 'Question',
    name: q.question,
    acceptedAnswer: { '@type': 'Answer', text: q.answer },
  })),
} : null;

const siteUrlBC = (Astro.site ? Astro.site.toString().replace(/\/$/, '') : (import.meta.env.PUBLIC_SITE_URL || 'https://remoteworkgeek.org'));
const siteNameBC = import.meta.env.PUBLIC_SITE_NAME || 'Editorial';
const postUrlBC = `${siteUrlBC}${Astro.url.pathname}`;
const categorySlug = category ? category.toLowerCase().trim().replace(/\s+/g, '-') : '';
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: siteNameBC, item: `${siteUrlBC}/` },
    ...(category ? [{ '@type': 'ListItem', position: 2, name: category, item: `${siteUrlBC}/category/${categorySlug}/` }] : []),
    { '@type': 'ListItem', position: (category ? 3 : 2), name: title, item: postUrlBC },
  ],
};

const schema = faqSchema ? {
  '@context': 'https://schema.org',
  '@graph': [articleSchema, breadcrumbSchema, faqSchema],
} : { '@context': 'https://schema.org', '@graph': [articleSchema, breadcrumbSchema] };

const lang = import.meta.env.PUBLIC_SITE_LANG || 'en';
const localeMap: Record<string, string> = { ko: 'ko-KR', ja: 'ja-JP', en: 'en-US' };
const tMap: Record<string, { published: string; updated: string; sources: string; visuals: string; video: string; related: string; explore: string }> = {
  ko: { published: '발행일', updated: '갱신', sources: '건 1차 자료', visuals: '종 시각 자료', video: '영상 요약', related: '함께 읽으면 좋은 글', explore: '관련 경로 열기' },
  ja: { published: '公開', updated: '更新', sources: '件の出典', visuals: '点のビジュアル', video: '動画要約', related: 'あわせて読みたい', explore: '関連ページを開く' },
  en: { published: 'Published', updated: 'Updated', sources: 'sources cited', visuals: 'visuals', video: 'Video summary', related: 'Related Reading', explore: 'Open related path' },
};
const t = tMap[lang] || tMap.en;
const locale = localeMap[lang] || 'en-US';
const validInternalLinks = internalLinks.filter((link) => link && link !== '/' && link !== Astro.url.pathname);
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  type="article"
  publishedTime={pubDate?.toISOString()}
  modifiedTime={(updatedDate || pubDate)?.toISOString()}
  schema={schema}
>
  <div class="progress-wrap" aria-hidden="true"><div id="reading-progress" class="progress-bar"></div></div>
  <article class="wrap py-12 md:py-16">
    <header class="mx-auto max-w-3xl">
      <a href="/posts/" class="num mb-8 inline-flex hover:text-[var(--accent)]">← All posts</a>
      {category && <a href={`/category/${categorySlug}/`} class="cat-tag ml-3">{category}</a>}
      <h1 class="mb-7 text-5xl font-medium leading-[1.05] tracking-[-.035em] md:text-7xl">{title}</h1>
      <p class="mb-7 text-xl leading-8 text-[var(--ink-soft)]">{description}</p>
      <div class="meta border-y py-4" style="border-color:var(--hairline);"><span class="inline-flex items-center gap-2 rounded-full border px-3 py-1" style="border-color:var(--hairline);"><span class="text-[var(--accent)]">✣</span>{siteNameBC} desk</span><span>·</span><time datetime={pubDate?.toISOString()}>{t.published} {pubDate?.toLocaleDateString(locale)}</time><span>·</span><span>◷ 7 min read</span><span>·</span><span>{sources.length} {t.sources}</span>{visualsCount>0 && <><span>·</span><span>{visualsCount} {t.visuals}</span></>}</div>
    </header>
    {heroImage && <figure class="mx-auto my-10 max-w-3xl"><div class="figure-art aspect-[16/8] rounded-[18px]"><img src={heroImage} alt={title} width="1280" height="720" loading="eager" fetchpriority="high" decoding="async" class="h-full w-full rounded-[18px] object-cover opacity-45 mix-blend-multiply" /></div></figure>}
    {affiliate && <AffiliateDisclosure />}
    <script is:inline>(()=>{const bar=document.getElementById('reading-progress');const set=()=>{const max=document.documentElement.scrollHeight-innerHeight;if(bar&&max>0)bar.style.width=Math.min(100,Math.max(0,scrollY/max*100))+'%'};addEventListener('scroll',set,{passive:true});set();document.addEventListener('click',e=>{if(e.target.closest('[data-copy-link]'))navigator.clipboard?.writeText(location.href)})})();</script>
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[220px_minmax(0,760px)_80px] lg:justify-center lg:gap-10">
      {headings.length > 0 && <aside class="hidden lg:block"><div class="toc-box sticky top-28"><p class="eyebrow mb-3"><span class="dot"></span>Contents</p><TOC headings={headings} /></div></aside>}
      <div class="prose-article min-w-0"><slot />{sources.length > 0 && <References sources={sources} />}</div>
      <aside class="hidden lg:block"><div class="sticky top-28 flex flex-col gap-3"><button data-bookmark data-title={title} data-url={Astro.url.pathname} class="icon-btn">☆</button><button data-copy-link class="icon-btn">↗</button></div></aside>
    </div>
    {validInternalLinks.length > 0 && <section class="mx-auto mt-14 max-w-3xl rounded-[18px] border p-6" style="border-color:var(--hairline);background:var(--surface);"><h2 class="mb-5 text-2xl">{t.related}</h2><ul class="grid gap-3 sm:grid-cols-2">{validInternalLinks.map((link)=><li><a href={link} class="btn btn-ghost w-full justify-between"><span class="truncate">{link}</span><span>→</span></a></li>)}</ul></section>}
    {tags.length > 0 && <footer class="mx-auto mt-12 max-w-3xl border-t pt-8" style="border-color:var(--hairline);"><div class="flex flex-wrap gap-2">{tags.map((tag)=><a href={`/tags/${tag.toLowerCase().trim().replace(/[\/\\&%?#=]/g, '-').replace(/\s+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '')}/`} class="rounded-full border px-3 py-1 text-sm text-[var(--muted)] hover:text-[var(--accent)]" style="border-color:var(--hairline);">#{tag}</a>)}</div></footer>}
  </article>
</BaseLayout>
