---
import RemoteMark from './RemoteMark.astro';
const siteName=import.meta.env.PUBLIC_SITE_NAME || 'remoteworkgeek.org';
const description=import.meta.env.PUBLIC_SITE_DESCRIPTION || '';
const year=new Date().getFullYear();
const followLinks=[{label:'Pinterest',href:import.meta.env.PUBLIC_SITE_PINTEREST},{label:'Instagram',href:import.meta.env.PUBLIC_SITE_INSTAGRAM},{label:'YouTube',href:import.meta.env.PUBLIC_SITE_YOUTUBE}].filter(x=>x.href);
---
<footer class="mt-24 border-t" style="border-color:var(--hairline);background:var(--surface);"><div class="wrap py-16"><div class="footer-grid"><div><div class="mb-5 flex items-center gap-3"><span class="text-[var(--accent)]"><RemoteMark class="h-10 w-10" /></span><h2 class="text-3xl">remoteworkgeek<span class="text-[var(--muted)]">.org</span></h2></div><p class="max-w-sm text-[var(--muted)]">{description}</p><div class="trust-logos mt-6"><span class="trust-logo">Cited</span><span class="trust-logo">Measured</span><span class="trust-logo">Editorial</span></div></div><div class="grid grid-cols-2 gap-8 md:grid-cols-4"><div><h4 class="eyebrow mb-4">Sections</h4><ul class="space-y-3 text-sm text-[var(--muted)]"><li><a href="/">Home</a></li><li><a href="/posts/">Posts</a></li><li><a href="/categories/">Categories</a></li><li><a href="/tools/">Tools</a></li><li><a href="/search/">Search</a></li></ul></div><div><h4 class="eyebrow mb-4">Editorial</h4><ul class="space-y-3 text-sm text-[var(--muted)]"><li><a href="/about/">About</a></li><li><a href="/editorial-process/">Process</a></li><li><a href="/editorial-standards/">Standards</a></li><li><a href="/contact/">Contact</a></li></ul></div><div><h4 class="eyebrow mb-4">Legal</h4><ul class="space-y-3 text-sm text-[var(--muted)]"><li><a href="/privacy/">Privacy</a></li><li><a href="/terms/">Terms</a></li><li><a href="/cookie-policy/">Cookie</a></li><li><a href="/affiliate-disclosure/">Affiliate</a></li></ul></div><div><h4 class="eyebrow mb-4">Follow</h4>{followLinks.length ? <ul class="space-y-3 text-sm text-[var(--muted)]">{followLinks.map((item)=><li><a href={item.href}>{item.label} →</a></li>)}</ul> : <p class="text-sm leading-7 text-[var(--muted)]">Official social channels will be linked after launch. Editorial corrections go through Contact.</p>}</div></div></div><div class="mt-12 border-t pt-6 text-xs leading-7 text-[var(--faint)]" style="border-color:var(--hairline);"><p>Content on this site is produced with AI assistance. All data points are verified against primary sources, and all sources are linked inline for direct verification.</p><p class="mt-2">© {year} {siteName} · All rights reserved · Built with Astro</p></div></div></footer>
