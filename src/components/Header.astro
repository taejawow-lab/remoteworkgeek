---
import ThemeToggle from './ThemeToggle.astro';
import RemoteMark from './RemoteMark.astro';
const siteName = import.meta.env.PUBLIC_SITE_NAME || 'remoteworkgeek.org';
const navItems = [
  { label: 'Posts', href: '/posts/' },
  { label: 'Categories', href: '/categories/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'About', href: '/about/' },
];
---
<header class="sticky top-0 z-50 border-b backdrop-blur-xl" style="border-color:var(--hairline);background:color-mix(in srgb,var(--paper) 88%,transparent);">
  <div class="wrap flex min-h-[68px] items-center justify-between gap-5">
    <a href="/" class="flex min-w-0 items-center gap-3" aria-label={`${siteName} home`}><span class="text-[var(--accent)]"><RemoteMark class="h-8 w-8" /></span><span class="truncate text-2xl font-semibold tracking-[-.03em]" style="font-family:var(--serif);">remoteworkgeek<span class="text-[var(--muted)]">.org</span></span></a>
    <nav aria-label="Primary navigation" class="hidden md:block"><ul class="flex items-center gap-8 text-[15px] text-[var(--ink-soft)]">{navItems.map((item)=><li><a href={item.href} class="hover:text-[var(--accent)]">{item.label}</a></li>)}</ul></nav>
    <div class="flex items-center gap-2"><a href="/search/" class="icon-btn" aria-label="Search"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="m16.5 16.5 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></a><ThemeToggle /><a href="/posts/" class="btn btn-primary hidden sm:inline-flex">Read latest →</a></div>
  </div>
  <nav aria-label="Mobile primary navigation" class="border-t md:hidden" style="border-color:var(--hairline);"><ul class="wrap flex gap-2 overflow-x-auto py-2 text-sm [-webkit-overflow-scrolling:touch]">{navItems.map((item)=><li class="shrink-0"><a href={item.href} class="inline-flex min-h-10 items-center rounded-full border px-4" style="border-color:var(--hairline);background:var(--surface);">{item.label}</a></li>)}</ul></nav>
</header>
