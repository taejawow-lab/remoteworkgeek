---
import RemoteMark from './RemoteMark.astro';
export interface Props { title:string; subtitle:string; ctaText?:string; ctaHref?:string; featured?: any; postCount?: number; }
const { ctaText='Read the latest', ctaHref='#latest', featured, postCount=39 } = Astro.props;
const date = new Date().toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' });
---
<section class="hero"><div class="wrap hero-grid"><div><p class="eyebrow hero-kicker"><span class="dot"></span>Desk 01 · A data-grounded publication</p><h1 class="hero-title">Home office,<br/><em>properly</em><br/>measured.</h1><p class="hero-dek">Setups, ergonomic furniture, and remote-work gear — every recommendation cross-checked against Cornell Ergonomics, OSHA, and independent measurement.</p><div class="hero-actions"><a href={ctaHref} class="btn btn-primary">{ctaText} →</a><a href="/tools/" class="btn btn-ghost">Setup checklist</a></div><div class="hero-stats"><div><div class="hs-num">{postCount}</div><div class="hs-label">preserved guides</div></div><div><div class="hs-num">4</div><div class="hs-label">work categories</div></div><div><div class="hs-num">100%</div><div class="hs-label">cited workflow</div></div></div><div class="trust-strip"><p class="ts-label eyebrow mt-6">Measured against</p><div class="trust-logos"><span class="trust-logo">Cornell Ergonomics</span><span class="trust-logo">OSHA</span><span class="trust-logo">NIST</span><span class="trust-logo">RTINGS</span></div></div></div><aside class="hero-card" data-cat="operations"><div class="flex items-center justify-between hero-card-top"><span class="eyebrow"><span class="dot"></span>№ 01 · Lead story</span><span class="num">{date}</span></div><div class="hero-card-art"><RemoteMark class="h-20 w-20" live /></div><p class="cat-tag">{featured?.data?.category || 'Remote Work Operations'}</p><h2 class="hero-card-title">{featured?.data?.title || 'Asynchronous Handoff and Time Zone Collaboration Plan'}</h2><p class="hero-card-dek text-[var(--muted)]">{featured?.data?.description || 'A remote-team operating plan for handoffs across time zones, escalation rules, and meeting-light collaboration.'}</p><a class="hero-card-link" href={featured ? `/posts/${featured.slug}/` : '/posts/'}>Read story →</a></aside></div></section>
