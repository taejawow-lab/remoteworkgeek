---
import RemoteMark from './RemoteMark.astro';
export interface Props { title:string; description:string; href:string; image?:string; category?:string; pubDate:Date; readingTime?:number; variant?:'feature'|'standard'|'row'; index?:number; }
const { title, description, href, image, category='Home Office', pubDate, readingTime=8, variant='standard', index=0 } = Astro.props;
const slug = category.toLowerCase().replace(/&/g,'and').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
const url = href.endsWith('/') ? href : `${href}/`;
const date = pubDate.toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' });
---
{variant === 'row' ? <article class="row-card" data-cat={slug}><div class="row-icon"><RemoteMark class="h-8 w-8" /></div><a href={url} class="min-w-0"><p class="cat-tag">{category}</p><h3 class="row-title">{title}</h3><p class="row-dek line-clamp-2">{description}</p></a><div class="meta hidden sm:flex"><span>{date}</span><span>·</span><span>{readingTime} min</span></div></article> : <article class="feature-card rwg-card" data-cat={slug}><a href={url} class="block"><div class="feature-figure">{image ? <img src={image} alt={title} class="h-full w-full rounded-[13px] object-cover opacity-50 mix-blend-multiply" loading="lazy" decoding="async" /> : <RemoteMark class="h-14 w-14" live={index===0} />}</div><p class="cat-tag">{category}</p><h3 class="feature-title">{title}</h3><p class="feature-dek line-clamp-3">{description}</p><div class="card-foot meta mt-4"><span>{date}</span><span>·</span><span>{readingTime} min read</span></div><span class="feature-watermark">{String(index+1).padStart(2,'0')}</span></a></article>}
